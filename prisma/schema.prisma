model PurchaseOrderLineTax {
  id            String            @id @default(cuid())
  lineId        String
  componentId   String
  name          String
  rate          Decimal           @db.Decimal(18, 4)
  amount        Decimal           @db.Decimal(18, 2)
  isWithholding Boolean
  line          PurchaseOrderLine @relation(fields: [lineId], references: [id])
  component     TaxComponent      @relation(fields: [componentId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("purchase_order_line_taxes")
}

model GoodsReceipt {
