  grandTotal              Decimal              @db.Decimal(18, 2)
  baseSubtotal            Decimal              @default(0) @db.Decimal(18, 2)
  baseTaxTotal            Decimal              @default(0) @db.Decimal(18, 2)
  baseWithholdingTotal    Decimal              @default(0) @db.Decimal(18, 2)
  baseGrandTotal          Decimal              @default(0) @db.Decimal(18, 2)
  receiptTolerancePercent Decimal              @default(0) @db.Decimal(7, 4)
  createdById             String
  lines                   PurchaseOrderLine[]
  organization            Organization         @relation(fields: [organizationId], references: [id])
  project                 Project              @relation(fields: [projectId], references: [id])
  approvalRequest         ApprovalRequest?     @relation(fields: [approvalRequestId], references: [id])
  vendor                  Party                @relation(fields: [vendorPartyId], references: [id])
  site                    ProjectSite?         @relation(fields: [siteId], references: [id])
  createdBy               User                 @relation(fields: [createdById], references: [id])
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([organizationId, code])
  @@index([projectId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  vendorBillLineRows VendorBillLine[]

  goodsReceiptLineRows GoodsReceiptLine[]

  id              String                 @id @default(cuid())
  orderId         String
  prLineId        String?
  itemVariantId   String
  description     String
  qty             Decimal                @db.Decimal(18, 4)
  uomId           String
  rate            Decimal                @db.Decimal(18, 4)
  discountPercent Decimal                @db.Decimal(7, 4)
