  projectId            String?
  partyId              String
  code                 String
  date                 DateTime              @db.Date
  dueDate              DateTime?             @db.Date
  stateId              String?
  currency             String
  currencyRef          Currency              @relation(fields: [currency], references: [code])
  exchangeRate         Decimal               @default(1) @db.Decimal(20, 10)
  subtotal             Decimal               @db.Decimal(18, 2)
  discountTotal        Decimal               @default(0) @db.Decimal(18, 2)
  taxTotal             Decimal               @db.Decimal(18, 2)
  withholdingTotal     Decimal               @default(0) @db.Decimal(18, 2)
  grandTotal           Decimal               @db.Decimal(18, 2)
  payableTotal         Decimal               @db.Decimal(18, 2)
  baseSubtotal         Decimal               @default(0) @db.Decimal(18, 2)
  baseDiscountTotal    Decimal               @default(0) @db.Decimal(18, 2)
  baseTaxTotal         Decimal               @default(0) @db.Decimal(18, 2)
  baseWithholdingTotal Decimal               @default(0) @db.Decimal(18, 2)
  baseGrandTotal       Decimal               @default(0) @db.Decimal(18, 2)
  basePayableTotal     Decimal               @default(0) @db.Decimal(18, 2)
  receivedTotal        Decimal               @default(0) @db.Decimal(18, 2)
  status               FinanceDocumentStatus @default(DRAFT)
  approvalRequestId    String?               @unique
  notes                String?
  createdById          String
  organization         Organization          @relation(fields: [organizationId], references: [id])
  project              Project?              @relation(fields: [projectId], references: [id])
  party                Party                 @relation(fields: [partyId], references: [id])
  placeOfSupply        State?                @relation(fields: [stateId], references: [id])
  approvalRequest      ApprovalRequest?      @relation(fields: [approvalRequestId], references: [id])
  createdBy            User                  @relation(fields: [createdById], references: [id])
  lines                SalesInvoiceLine[]
  allocations          PaymentAllocation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, partyId, status, date])
  @@index([organizationId, status, date])
  @@index([projectId, status])
  @@map("sales_invoices")
