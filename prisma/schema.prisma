  exchangeRate      Decimal            @default(1) @db.Decimal(20, 10)
  siteId            String?
  receivedDate      DateTime           @db.Date
  challanNumber     String?
  vehicleNumber     String?
  receivedById      String
  lines             GoodsReceiptLine[]
  organization      Organization       @relation(fields: [organizationId], references: [id])
  project           Project            @relation(fields: [projectId], references: [id])
  approvalRequest   ApprovalRequest?   @relation(fields: [approvalRequestId], references: [id])
  order             PurchaseOrder      @relation(fields: [poId], references: [id])
  site              ProjectSite?       @relation(fields: [siteId], references: [id])
  receivedBy        User               @relation(fields: [receivedById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([organizationId, code])
  @@index([projectId, status])
