model GoodsReceiptLine {
  vendorBillLineRows VendorBillLine[]

  id          String            @id @default(cuid())
  receiptId   String
  poLineId    String
  receivedQty Decimal           @db.Decimal(18, 4)
  acceptedQty Decimal           @db.Decimal(18, 4)
