model SalesInvoiceLine {
  id               String                @id @default(cuid())
  invoiceId        String
  itemVariantId    String?
  description      String
  qty              Decimal               @db.Decimal(18, 4)
  uomId            String
  rate             Decimal               @db.Decimal(18, 4)
  discountPercent  Decimal               @default(0) @db.Decimal(7, 4)
  taxGroupId       String?
  lineSubtotal     Decimal               @db.Decimal(18, 2)
  lineTax          Decimal               @db.Decimal(18, 2)
  lineTotal        Decimal               @db.Decimal(18, 2)
  fromProjectStock Boolean               @default(false)
  stockMovementId  String?               @unique
  invoice          SalesInvoice          @relation(fields: [invoiceId], references: [id])
  variant          ItemVariant?          @relation(fields: [itemVariantId], references: [id])
  uom              Uom                   @relation(fields: [uomId], references: [id])
  taxGroup         TaxGroup?             @relation(fields: [taxGroupId], references: [id])
  stockMovement    StockMovement?        @relation(fields: [stockMovementId], references: [id])
  taxes            SalesInvoiceLineTax[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([invoiceId])
  @@map("sales_invoice_lines")
}

model SalesInvoiceLineTax {
  id            String           @id @default(cuid())
  lineId        String
  componentId   String
  name          String
  rate          Decimal          @db.Decimal(18, 4)
  amount        Decimal          @db.Decimal(18, 2)
  isWithholding Boolean
  line          SalesInvoiceLine @relation(fields: [lineId], references: [id])
  component     TaxComponent     @relation(fields: [componentId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([lineId])
  @@map("sales_invoice_line_taxes")
}

/// Global ISO 4217 currency master. Tenants opt in through TenantCurrency.
model Currency {
  code      String   @id
  name      String
  symbol    String
  decimals  Int      @default(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantCurrencies TenantCurrency[]
  exchangeRates    ExchangeRate[]
  organizations    Organization[]
  parties          Party[]
  projects         Project[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  vendorBills      VendorBill[]
  paymentRequests  PaymentRequest[]
  payments         Payment[]
  salesInvoices    SalesInvoice[]
  expenses         Expense[]
  costEntries      CostEntry[]

  @@map("currencies")
}

/// Currencies a tenant may use. The base currency of each organization is always enabled.
model TenantCurrency {
  id           String   @id @default(cuid())
  tenantId     String
  currencyCode String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency     Currency @relation(fields: [currencyCode], references: [code])

  @@unique([tenantId, currencyCode])
  @@map("tenant_currencies")
}

/// Manual dated rate: base-currency units per 1 unit of currencyCode.
model ExchangeRate {
  id             String       @id @default(cuid())
  organizationId String
  currencyCode   String
  rateDate       DateTime     @db.Date
  rate           Decimal      @db.Decimal(20, 10)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  currency       Currency     @relation(fields: [currencyCode], references: [code])
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@unique([organizationId, currencyCode, rateDate])
  @@index([organizationId, rateDate])
  @@map("exchange_rates")
}

model AccountTemplate {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  systemKey String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts  LedgerAccount[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@map("account_templates")
}

model LedgerAccount {
  id             String      @id @default(cuid())
  organizationId String
  templateId     String?
  code           String
  name           String
  type           AccountType
  systemKey      String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       AccountTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  journalLines   JournalLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@unique([id, organizationId])
  @@map("ledger_accounts")
}

model AccountingSource {
  id             String       @id @default(cuid())
  organizationId String
  sourceType     String
  sourceId       String
  revision       Int          @default(0)
  fingerprint    String?
  currentEntryId String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentEntry   JournalEntry? @relation("CurrentSourceJournal", fields: [currentEntryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  entries        JournalEntry[] @relation("SourceJournals")

  @@unique([organizationId, sourceType, sourceId])
  @@unique([id, organizationId])
  @@unique([currentEntryId, organizationId])
  @@map("accounting_sources")
}

model JournalEntry {
  id                String       @id @default(cuid())
  organizationId    String
  code              String
  date              DateTime     @db.Date
  description       String
  status            JournalStatus @default(DRAFT)
  sourceType        String       @default("MANUAL")
  sourceDocumentId  String?
  accountingSourceId String?
  revision          Int?
  reversalOfId      String?      @unique
  approvalRequestId String?      @unique
  createdById       String
  postedById        String?
  postedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator           User         @relation("JournalCreator", fields: [createdById], references: [id])
  poster            User?        @relation("JournalPoster", fields: [postedById], references: [id])
  lines             JournalLine[]
  source             AccountingSource? @relation("SourceJournals", fields: [accountingSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  currentForSource   AccountingSource? @relation("CurrentSourceJournal")
  reversalOf         JournalEntry? @relation("JournalReversal", fields: [reversalOfId, organizationId], references: [id, organizationId])
  reversal           JournalEntry? @relation("JournalReversal")
  approvalRequest    ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@unique([accountingSourceId, revision])
  @@unique([reversalOfId, organizationId])
  @@index([organizationId, status, date])
  @@map("journal_entries")
}

model JournalLine {
  id              String        @id @default(cuid())
  journalEntryId  String
  organizationId  String
  accountId       String
  description     String        @default("")
  debit           Decimal       @default(0) @db.Decimal(18, 2)
  credit          Decimal       @default(0) @db.Decimal(18, 2)
  projectId       String?
  partyId         String?
  taxComponentId  String?
  taxName         String?
  taxRate         Decimal?      @db.Decimal(18, 4)
  taxBaseAmount   Decimal?      @db.Decimal(18, 2)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry @relation(fields: [journalEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  account         LedgerAccount @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  party           Party?        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  taxComponent    TaxComponent? @relation(fields: [taxComponentId], references: [id], onDelete: Restrict)

  @@index([organizationId, accountId, journalEntryId])
  @@index([projectId])
  @@index([partyId])
  @@index([taxComponentId])
  @@map("journal_lines")
}
