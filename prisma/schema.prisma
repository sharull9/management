  netRate         Decimal                @db.Decimal(24, 8)
  taxGroupId      String?
  receivedQty     Decimal                @default(0) @db.Decimal(18, 4)
  acceptedQty     Decimal                @default(0) @db.Decimal(18, 4)
  stockFactor     Decimal                @db.Decimal(24, 8)
  stockUomId      String
  taxes           PurchaseOrderLineTax[]
  order           PurchaseOrder          @relation(fields: [orderId], references: [id])
  prLine          PurchaseRequestLine?   @relation(fields: [prLineId], references: [id])
