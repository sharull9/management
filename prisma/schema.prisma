  uom           Uom           @relation(fields: [uomId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("stock_transfer_lines")
}

model StockMovement {
  salesInvoiceLine SalesInvoiceLine?

  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  itemVariantId  String
  date           DateTime          @db.Date
  type           StockMovementType
  qty            Decimal           @db.Decimal(18, 4)
  /// Stock is valued in the organization's BASE currency (unitCost and totalCost).
  unitCost       Decimal           @db.Decimal(24, 8)
  totalCost      Decimal           @db.Decimal(24, 8)
  sourceType     String
  sourceId       String
  stageId        String?
  taskId         String?
  organization   Organization      @relation(fields: [organizationId], references: [id])
  project        Project           @relation(fields: [projectId], references: [id])
  variant        ItemVariant       @relation(fields: [itemVariantId], references: [id])
  stage          Stage?            @relation(fields: [stageId], references: [id])
  task           Task?             @relation(fields: [taskId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, sourceType, sourceId, type])
  @@index([projectId, itemVariantId])
  @@map("stock_movements")
}

enum MaterialCostRecognition {
  ON_RECEIPT
  ON_CONSUMPTION
}

enum FinanceDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK
  UPI
  CHEQUE
  OTHER
}

enum PaymentPurpose {
  ADVANCE
  BILL_SETTLEMENT
  OTHER
}

enum PaymentDirection {
  OUTGOING
  INCOMING
}

enum PaymentStatus {
  POSTED
  VOID
}

/// Attachments use Attachment.entityType = "VendorBill" and entityId = id.
model VendorBill {
  id                   String                @id @default(cuid())
  organizationId       String
  projectId            String
  partyId              String
  code                 String
  date                 DateTime              @default(now()) @db.Date
  vendorInvoiceNo      String
  vendorInvoiceDate    DateTime              @db.Date
  dueDate              DateTime?             @db.Date
  purchaseOrderId      String?
  currency             String
  currencyRef          Currency              @relation(fields: [currency], references: [code])
  exchangeRate         Decimal               @default(1) @db.Decimal(20, 10)
  subtotal             Decimal               @db.Decimal(18, 2)
  discountTotal        Decimal               @default(0) @db.Decimal(18, 2)
  taxTotal             Decimal               @db.Decimal(18, 2)
  withholdingTotal     Decimal               @default(0) @db.Decimal(18, 2)
  grandTotal           Decimal               @db.Decimal(18, 2)
  payableTotal         Decimal               @db.Decimal(18, 2)
  baseSubtotal         Decimal               @default(0) @db.Decimal(18, 2)
  baseDiscountTotal    Decimal               @default(0) @db.Decimal(18, 2)
  baseTaxTotal         Decimal               @default(0) @db.Decimal(18, 2)
  baseWithholdingTotal Decimal               @default(0) @db.Decimal(18, 2)
  baseGrandTotal       Decimal               @default(0) @db.Decimal(18, 2)
  basePayableTotal     Decimal               @default(0) @db.Decimal(18, 2)
  paidTotal            Decimal               @default(0) @db.Decimal(18, 2)
  status               FinanceDocumentStatus @default(DRAFT)
  approvalRequestId    String?               @unique
  notes                String?
  createdById          String
  organization         Organization          @relation(fields: [organizationId], references: [id])
  project              Project               @relation(fields: [projectId], references: [id])
  party                Party                 @relation(fields: [partyId], references: [id])
  purchaseOrder        PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  approvalRequest      ApprovalRequest?      @relation(fields: [approvalRequestId], references: [id])
  createdBy            User                  @relation(fields: [createdById], references: [id])
  lines                VendorBillLine[]
  paymentRequests      PaymentRequestBill[]
  allocations          PaymentAllocation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, partyId, status, date])
  @@index([organizationId, status, date])
  @@index([projectId, status])
  @@index([purchaseOrderId])
  @@map("vendor_bills")
}

model VendorBillLine {
  id              String              @id @default(cuid())
  billId          String
  poLineId        String?
  grnLineId       String?
  itemVariantId   String?
  description     String
  qty             Decimal             @db.Decimal(18, 4)
  uomId           String
  rate            Decimal             @db.Decimal(18, 4)
  discountPercent Decimal             @default(0) @db.Decimal(7, 4)
  taxGroupId      String?
  lineSubtotal    Decimal             @db.Decimal(18, 2)
  lineTax         Decimal             @db.Decimal(18, 2)
  lineTotal       Decimal             @db.Decimal(18, 2)
  poRate          Decimal?            @db.Decimal(18, 4)
  varianceAmount  Decimal             @default(0) @db.Decimal(18, 2)
  bill            VendorBill          @relation(fields: [billId], references: [id])
  poLine          PurchaseOrderLine?  @relation(fields: [poLineId], references: [id])
  grnLine         GoodsReceiptLine?   @relation(fields: [grnLineId], references: [id])
  variant         ItemVariant?        @relation(fields: [itemVariantId], references: [id])
  uom             Uom                 @relation(fields: [uomId], references: [id])
  taxGroup        TaxGroup?           @relation(fields: [taxGroupId], references: [id])
  taxes           VendorBillLineTax[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([billId])
  @@index([poLineId])
  @@index([grnLineId])
  @@map("vendor_bill_lines")
}

model VendorBillLineTax {
  id            String         @id @default(cuid())
  lineId        String
  componentId   String
  name          String
  rate          Decimal        @db.Decimal(18, 4)
  amount        Decimal        @db.Decimal(18, 2)
  isWithholding Boolean
  line          VendorBillLine @relation(fields: [lineId], references: [id])
  component     TaxComponent   @relation(fields: [componentId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([lineId])
  @@map("vendor_bill_line_taxes")
}

model PaymentRequest {
  id                String               @id @default(cuid())
  organizationId    String
  projectId         String?
  partyId           String
  code              String
  date              DateTime             @default(now()) @db.Date
  currency          String
  currencyRef       Currency             @relation(fields: [currency], references: [code])
  exchangeRate      Decimal              @default(1) @db.Decimal(20, 10)
  amount            Decimal              @db.Decimal(18, 2)
  baseAmount        Decimal              @default(0) @db.Decimal(18, 2)
  mode              PaymentMode
  purpose           PaymentPurpose
  requestedById     String
  reason            String
  status            PaymentRequestStatus @default(DRAFT)
  approvalRequestId String?              @unique
  organization      Organization         @relation(fields: [organizationId], references: [id])
  project           Project?             @relation(fields: [projectId], references: [id])
  party             Party                @relation(fields: [partyId], references: [id])
  requestedBy       User                 @relation(fields: [requestedById], references: [id])
  approvalRequest   ApprovalRequest?     @relation(fields: [approvalRequestId], references: [id])
  bills             PaymentRequestBill[]
  payments          Payment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, partyId, status, date])
  @@index([organizationId, status, date])
  @@index([projectId, status])
  @@map("payment_requests")
}

model PaymentRequestBill {
  id               String         @id @default(cuid())
  paymentRequestId String
  billId           String
  amount           Decimal        @db.Decimal(18, 2)
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id])
  bill             VendorBill     @relation(fields: [billId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([paymentRequestId, billId])
  @@index([billId])
  @@map("payment_request_bills")
}

model Payment {
  id                String              @id @default(cuid())
  organizationId    String
  code              String
  partyId           String
  direction         PaymentDirection
  date              DateTime            @db.Date
  mode              PaymentMode
  reference         String?
  currency          String
  currencyRef       Currency            @relation(fields: [currency], references: [code])
  exchangeRate      Decimal             @default(1) @db.Decimal(20, 10)
  amount            Decimal             @db.Decimal(18, 2)
  baseAmount        Decimal             @default(0) @db.Decimal(18, 2)
  allocatedAmount   Decimal             @default(0) @db.Decimal(18, 2)
  unallocatedAmount Decimal             @db.Decimal(18, 2)
  paymentRequestId  String?
  projectId         String?
  notes             String?
  status            PaymentStatus       @default(POSTED)
  createdById       String
  organization      Organization        @relation(fields: [organizationId], references: [id])
  party             Party               @relation(fields: [partyId], references: [id])
  paymentRequest    PaymentRequest?     @relation(fields: [paymentRequestId], references: [id])
  project           Project?            @relation(fields: [projectId], references: [id])
  createdBy         User                @relation(fields: [createdById], references: [id])
  allocations       PaymentAllocation[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, partyId, status, date])
  @@index([organizationId, status, date])
  @@index([organizationId, direction, date])
  @@index([paymentRequestId])
  @@index([projectId])
  @@map("payments")
}

model PaymentAllocation {
  id                 String        @id @default(cuid())
  paymentId          String
  vendorBillId       String?
  salesInvoiceId     String?
  amount             Decimal       @db.Decimal(18, 2)
  /// Allocated amount in base currency at the payment's rate.
  baseAmount         Decimal       @default(0) @db.Decimal(18, 2)
  /// Same amount in base currency at the allocated document's rate.
  documentBaseAmount Decimal       @default(0) @db.Decimal(18, 2)
  /// Realised FX = baseAmount - documentBaseAmount (sign convention: docs/PHASE3C_SHARED.md).
  fxDifference       Decimal       @default(0) @db.Decimal(18, 2)
  allocatedAt        DateTime      @default(now())
  allocatedById      String
  payment            Payment       @relation(fields: [paymentId], references: [id])
  vendorBill         VendorBill?   @relation(fields: [vendorBillId], references: [id])
  salesInvoice       SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  allocatedBy        User          @relation(fields: [allocatedById], references: [id])

  @@index([paymentId])
  @@index([vendorBillId])
  @@index([salesInvoiceId])
  @@map("payment_allocations")
}

model SalesInvoice {
