  costType            CostType
  /// Project-currency amount; budgets, dashboards and ledgers sum this field.
  amount              Decimal        @db.Decimal(18, 2)
  originalCurrency    String
  originalAmount      Decimal        @db.Decimal(18, 2)
  /// Base units per 1 unit of originalCurrency.
  exchangeRate        Decimal        @default(1) @db.Decimal(20, 10)
  baseAmount          Decimal        @db.Decimal(18, 2)
