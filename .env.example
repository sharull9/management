# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Approval reminders: positive hours, defaults to 24; up to three reminders.
APPROVAL_REMINDER_HOURS="24"

# Workflow uses the bundled local world in development (no configuration).
# Self-hosted production requires a long-lived Postgres worker, bootstrap tables,
# and a startup hook calling getWorld().start() from workflow/runtime.
# See docs/ARCHITECTURE.md before enabling these settings.
# WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
# WORKFLOW_POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/WORKFLOW_DB"
# WORKFLOW_LOCAL_BASE_URL="http://localhost:3000"
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY="10"
# WORKFLOW_POSTGRES_MAX_POOL_SIZE="10"
